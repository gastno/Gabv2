FROM node:24-alpine AS dependencies
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

FROM node:24-alpine AS runtime
ENV NODE_ENV=production \
    PORT=5000
WORKDIR /app/backend
RUN addgroup -S app && adduser -S -G app app \
    && mkdir -p /app/uploads \
    && chown -R app:app /app/backend /app/uploads
COPY --from=dependencies --chown=app:app /app/backend/node_modules ./node_modules
COPY --chown=app:app backend/package.json ./package.json
COPY --chown=app:app backend/src ./src
COPY --chown=app:app database/migrations /app/database/migrations
USER app
EXPOSE 5000
HEALTHCHECK --interval=20s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:5000/health/ready').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["node", "src/index.js"]
